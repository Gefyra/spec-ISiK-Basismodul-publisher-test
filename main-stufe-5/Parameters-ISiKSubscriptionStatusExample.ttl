@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://gefyra.info/training/Parameters/ISiKSubscriptionStatusExample> a fhir:Parameters ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "ISiKSubscriptionStatusExample"] ; # 
  fhir:meta [
     fhir:profile ( [
       fhir:v "http://gefyra.info/training/StructureDefinition/ISiKSubscriptionStatus"^^xsd:anyURI ;
       fhir:l <http://gefyra.info/training/StructureDefinition/ISiKSubscriptionStatus>
     ] )
  ] ; # 
  fhir:parameter ( [
     fhir:name [ fhir:v "subscription" ] ;
     fhir:value [
       a fhir:Reference ;
       fhir:l <http://gefyra.info/training/Subscription/1> ;
       fhir:reference [ fhir:v "Subscription/1" ]
     ]
  ] [
     fhir:name [ fhir:v "topic" ] ;
     fhir:value [
       a fhir:Canonical ;
       fhir:v "https://gematik.de/fhir/isik/SubscriptionTopic/patient-merge"^^xsd:anyURI ;
       fhir:l <https://gematik.de/fhir/isik/SubscriptionTopic/patient-merge>
     ]
  ] [
     fhir:name [ fhir:v "status" ] ;
     fhir:value [
       a fhir:Code ;
       fhir:v "active"
     ]
  ] [
     fhir:name [ fhir:v "type" ] ;
     fhir:value [
       a fhir:Code ;
       fhir:v "event-notification"
     ]
  ] [
     fhir:name [ fhir:v "events-since-subscription-start" ] ;
     fhir:value [
       a fhir:String ;
       fhir:v "1"
     ]
  ] [
     fhir:name [ fhir:v "notification-event" ] ;
     fhir:part ( [
       fhir:name [ fhir:v "event-number" ] ;
       fhir:value [
         a fhir:String ;
         fhir:v "1"
       ]
     ] [
       fhir:name [ fhir:v "timestamp" ] ;
       fhir:value [
         a fhir:Instant ;
         fhir:v "2024-02-22T18:30:05+01:00"^^xsd:dateTime
       ]
     ] [
       fhir:name [ fhir:v "focus" ] ;
       fhir:value [
         a fhir:Reference ;
         fhir:l <http://gefyra.info/training/Patient/DorisQuelle> ;
         fhir:reference [ fhir:v "Patient/DorisQuelle" ]
       ]
     ] )
  ] ) . # 

