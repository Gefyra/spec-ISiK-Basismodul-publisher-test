         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "ValueSet"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://gefyra.info/training/ValueSet/ISiKSpecificGenericTempLoincVS> ;
         fhir:reference [ fhir:v "ValueSet/ISiKSpecificGenericTempLoincVS" ]
       ] ;
       fhir:name [ fhir:v "ISiK Specific Generische Koerpertemperatur LOINC Konzepte" ] ;
       fhir:description [ fhir:v "ValueSet der spezifischen generischen Körperkerntemperatur LOINC Konzepte die nicht dazu dienen eine Körperkerntemperatur zu messen" ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
