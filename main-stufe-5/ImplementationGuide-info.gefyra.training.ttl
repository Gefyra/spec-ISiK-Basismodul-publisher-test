       fhir:reference [
         fhir:l <http://gefyra.info/training/StructureDefinition/AppointmentReplaces> ;
         fhir:reference [ fhir:v "StructureDefinition/AppointmentReplaces" ]
       ] ;
       fhir:name [ fhir:v "AppointmentReplaces" ] ;
       fhir:description [ fhir:v "Mit dieser Erweiterung kann eine neue Appointment-Ressource auf eine frühere, ersetzte Appointment-Ressource verweisen, z. B. bei einer Terminverschiebung oder -umbuchung. Dies erleichtert die Nachverfolgung von Terminänderungen und stellt sicher, dass der Zusammenhang zwischen ursprünglichem und aktuellem Termin eindeutig dokumentiert ist." ] ;
