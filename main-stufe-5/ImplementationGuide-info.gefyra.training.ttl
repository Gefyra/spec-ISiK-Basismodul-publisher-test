         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "Observation"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://gefyra.info/training/Observation/ISiKKoerpergewichtExample> ;
         fhir:reference [ fhir:v "Observation/ISiKKoerpergewichtExample" ]
       ] ;
