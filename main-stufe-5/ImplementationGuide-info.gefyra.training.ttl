       fhir:reference [
         fhir:l <http://gefyra.info/training/Observation/ISiKBlutdruckSystemischArteriellMinExample> ;
         fhir:reference [ fhir:v "Observation/ISiKBlutdruckSystemischArteriellMinExample" ]
       ] ;
