       ] ;
       fhir:name [ fhir:v "ISiKKoerpergewichtMaxExample" ] ;
       fhir:example [
         a fhir:Canonical ;
         fhir:v "http://gefyra.info/training/StructureDefinition/ISiKKoerpergewicht"^^xsd:anyURI ;
