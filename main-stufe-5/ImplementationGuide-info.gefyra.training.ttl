         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://gefyra.info/training/CodeSystem/ISiKMedikationsartCS> ;
         fhir:reference [ fhir:v "CodeSystem/ISiKMedikationsartCS" ]
       ] ;
       fhir:name [ fhir:v "ISiK Medikationsart" ] ;
       fhir:description [ fhir:v "ISiK Therapiearten für Medikation" ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "StructureDefinition:resource"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://gefyra.info/training/StructureDefinition/ISiKMedikationsListe> ;
         fhir:reference [ fhir:v "StructureDefinition/ISiKMedikationsListe" ]
       ] ;
       fhir:name [ fhir:v "ISiK Medikationsliste" ] ;
       fhir:description [ fhir:v "Dieses Profil ermöglicht die Zusammenführung einzelner MedikationsInformationen eines Patienten in ISiK Szenarien.\n\nDie MedicationList verweist auf MedicationStatement-Ressourcen und bildet Medikationen ab, die aktuell eingenommen, im Krankenhaus verabreicht oder aus externen Quellen dokumentiert wurden - etwa durch Patientenangaben, Medikationspläne oder Entlassbriefe.\nIm Unterschied zum eMP der ePA ist die ISiK-MedikationsListe dynamisch generierbar und systemseitig aktualisierbar. Sie kann auch Informationen enthalten, die außerhalb des eigenen Hauses erfasst wurden – sofern diese dem System strukturiert vorliegen (z.B. durch eMP-Import).\nEin Import aus dem eMP ist möglich, aber nicht verpflichtend." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
