         fhir:v "http://gefyra.info/training/StructureDefinition/ISiKKoerpertemperatur"^^xsd:anyURI ;
         fhir:l <http://gefyra.info/training/StructureDefinition/ISiKKoerpertemperatur>
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
