           fhir:v "ValueSet"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://gefyra.info/training/ValueSet/ISiKSpecificKernTempLoincVS> ;
         fhir:reference [ fhir:v "ValueSet/ISiKSpecificKernTempLoincVS" ]
       ] ;
