         fhir:v "http://gefyra.info/training/StructureDefinition/ISiKRaucherStatus"^^xsd:anyURI ;
         fhir:l <http://gefyra.info/training/StructureDefinition/ISiKRaucherStatus>
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
